<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Login — The Smart Move</title>
<meta name="robots" content="noindex, nofollow" />
<link rel="preconnect" href="https://api.fontshare.com" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@700,900,500&f[]=general-sans@600,700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='34' fill='none' stroke='%23D4AF37' stroke-width='5'/%3E%3Cpath d='M50 8 L58 30 L50 24 L42 30 Z' fill='%2300C853'/%3E%3Crect x='47' y='24' width='6' height='40' fill='%2300C853'/%3E%3Ctext x='50' y='68' font-family='Arial' font-size='30' font-weight='900' fill='%23D4AF37' text-anchor='middle'%3ESM%3C/text%3E%3C/svg%3E" />
<link rel="stylesheet" href="/css/style.css" />
<style>
  .login-select-wrap{ max-width:640px; margin-inline:auto; padding-top:clamp(120px,15vw,180px); padding-bottom:5rem; }
  .login-cards{ display:grid; grid-template-columns:1fr 1fr; gap:1.2rem; margin-top:2.4rem; }
  @media (max-width:640px){ .login-cards{ grid-template-columns:1fr; } }
  .login-card{ display:flex; align-items:center; gap:1rem; padding:1.6rem; border-radius:var(--radius-lg); background:linear-gradient(170deg,rgba(255,255,255,.05),rgba(255,255,255,.015)); border:1px solid var(--stroke-soft); transition:border-color .25s, transform .25s; }
  .login-card:hover{ border-color:var(--gold); transform:translateY(-2px); }
  .login-card .ic{ width:52px; height:52px; flex:none; border-radius:14px; display:grid; place-items:center; color:var(--gold); background:linear-gradient(160deg,rgba(212,175,55,.16),transparent); border:1px solid var(--stroke); }
  .login-card .ic svg{ width:24px; height:24px; }
  .login-card b{ font-size:1.05rem; }
  .login-card span{ display:block; color:var(--ink-faint); font-size:.82rem; margin-top:.15rem; }
</style>
</head>
<body>
<%- include('partials/nav', { home: false }) %>

<main>
<div class="wrap login-select-wrap">
  <div class="section-head reveal in" style="margin-inline:auto; text-align:center">
    <span class="eyebrow">Login</span>
    <h2 style="margin-top:1.1rem">Select Login Type</h2>
    <p>Choose how you'd like to sign in to The Smart Move.</p>
  </div>

  <div class="login-cards">
    <a href="/student/login" class="login-card reveal in">
      <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a8 8 0 0 1 16 0v1"/></svg></span>
      <div><b>Student Login</b><span>Access your programs and enrollments</span></div>
    </a>
    <a href="/admin/login" class="login-card reveal in">
      <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg></span>
      <div><b>Admin Login</b><span>Manage the site (admins only)</span></div>
    </a>
  </div>
</div>
</main>

<%- include('partials/footer', { home: false }) %>
</body>
</html>
