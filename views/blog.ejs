<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<!-- <title>Market Insights — The Smart Move</title> -->
 <title>Blog — The Smart Move</title>
<meta name="description" content="Educational articles, trading insights and practical strategy from The Smart Move — India's premium trading education institute and community." />
<meta name="theme-color" content="#0B0B0B" />
<link rel="preconnect" href="https://api.fontshare.com" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@700,900,500&f[]=general-sans@600,700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='34' fill='none' stroke='%23D4AF37' stroke-width='5'/%3E%3Cpath d='M50 8 L58 30 L50 24 L42 30 Z' fill='%2300C853'/%3E%3Crect x='47' y='24' width='6' height='40' fill='%2300C853'/%3E%3Ctext x='50' y='68' font-family='Arial' font-size='30' font-weight='900' fill='%23D4AF37' text-anchor='middle'%3ESM%3C/text%3E%3C/svg%3E" />
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<%- include('partials/nav', { home: false }) %>

<main>
<section id="blog-listing" style="padding-top:clamp(120px,15vw,180px)">
  <div class="wrap">
    <div class="section-head reveal in">
      <!-- <span class="eyebrow">Market Insights</span> -->
       <span class="eyebrow">Blog</span>
      <h2>Stay Ahead of<br>the Markets.</h2>
      <p>Educational articles, trading insights and practical strategy to help you become a more informed trader.</p>
    </div>

    <% if (notFound) { %>
      <div style="padding:1.2rem 1.4rem; border-radius:12px; background:rgba(255,80,80,.1); border:1px solid rgba(255,80,80,.3); color:#ff9d9d; margin-bottom:2rem">
        That article couldn't be found — here's everything we've published instead.
      </div>
    <% } %>

    <% if (posts.length === 0) { %>
      <p style="color:var(--ink-faint); text-align:center; padding:3rem 0">No articles published yet — check back soon.</p>
    <% } else { %>
      <div class="blog">
        <% posts.forEach(function(post) { %>
          <article class="acard reveal in">
            <div class="thumb"><span class="cat"><%= post.category %></span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 3v18h18"/><rect x="7" y="10" width="2.5" height="7"/><rect x="12" y="6" width="2.5" height="11"/><rect x="17" y="12" width="2.5" height="5"/></svg></div>
            <div class="body">
              <h3><%= post.title %></h3>
              <div class="meta"><span><%= post.category %></span><span>·</span><span><%= post.read_time_minutes %> min read</span></div>
              <a href="/blog/<%= post.slug %>" class="read">Read article <svg viewBox="0 0 24 24" width="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            </div>
          </article>
        <% }); %>
      </div>
    <% } %>
  </div>
</section>
</main>

<%- include('partials/footer', { home: false }) %>
</body>
</html>
