<%
// `active` (string, passed by the including page) highlights the current
// section: 'dashboard' | 'enrollments' | 'sessions' | 'blog' | 'programs' | 'leads' | 'admins'
const isActive = (key) => active === key ? ' active' : '';
%>
<style>
  .admin-shell{ display:flex; min-height:100vh; }
  .admin-sidebar{ width:72px; flex:none; background:var(--bg-2); border-right:1px solid var(--stroke-soft); transition:width .22s ease; display:flex; flex-direction:column; overflow:hidden; }
  .admin-shell.expanded .admin-sidebar{ width:236px; }
  .side-top{ display:flex; align-items:center; justify-content:space-between; padding:1.1rem .9rem; flex:none; }
  .side-top .brand-mark{ display:flex; align-items:center; gap:.6rem; overflow:hidden; }
  .side-top .brand-mark span{ font-family:var(--font-data); font-weight:700; font-size:.8rem; color:var(--ink); white-space:nowrap; opacity:0; transition:opacity .15s; }
  .admin-shell.expanded .side-top .brand-mark span{ opacity:1; }
  .toggle-btn{ background:none; border:none; color:var(--ink-faint); cursor:pointer; padding:.4rem; flex:none; border-radius:8px; display:flex; }
  .toggle-btn:hover{ background:rgba(255,255,255,.06); color:var(--ink); }
  .side-nav{ flex:1; display:flex; flex-direction:column; gap:.15rem; padding:.6rem; overflow-y:auto; overflow-x:hidden; }
  .side-bottom{ padding:.6rem; border-top:1px solid var(--stroke-soft); flex:none; }
  .side-link{ display:flex; align-items:center; gap:.85rem; padding:.7rem .78rem; border-radius:10px; color:var(--ink-soft); font-size:.86rem; white-space:nowrap; text-decoration:none; }
  .side-link:hover{ background:rgba(255,255,255,.05); color:var(--ink); }
  .side-link.active{ background:rgba(212,175,55,.12); color:var(--gold); }
  .side-link svg{ width:20px; height:20px; flex:none; }
  .side-link .label{ opacity:0; transition:opacity .15s; }
  .admin-shell.expanded .side-link .label{ opacity:1; }
  .side-link.logout-link{ padding:0; }
  .side-link.logout-link button{ background:none; border:none; padding:.7rem .78rem; margin:0; font:inherit; color:inherit; display:flex; align-items:center; gap:.85rem; cursor:pointer; width:100%; text-align:left; }
  .admin-main{ flex:1; min-width:0; padding:2.6rem clamp(1.2rem,4vw,3rem) 4rem; }
</style>

<aside class="admin-sidebar">
  <div class="side-top">
    <div class="brand-mark">
      <svg viewBox="0 0 100 100" width="30" height="30" fill="none" style="flex:none">
        <circle cx="50" cy="52" r="33" stroke="#D4AF37" stroke-width="5"/>
        <path d="M50 5 L57 26 L50 21 L43 26 Z" fill="#00C853"/>
        <rect x="47.2" y="21" width="5.6" height="46" rx="2" fill="#00C853"/>
      </svg>
      <span>THE SMART MOVE</span>
    </div>
    <button class="toggle-btn" id="sidebarToggle" aria-label="Toggle sidebar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M9 4v16"/></svg>
    </button>
  </div>

  <nav class="side-nav">
    <a href="/admin/dashboard" class="side-link<%= isActive('dashboard') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
      <span class="label">Dashboard</span>
    </a>
    <a href="/admin/enrollments" class="side-link<%= isActive('enrollments') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="8" y="2" width="8" height="4" rx="1"/><path d="M9 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-3"/><path d="M9 14l2 2 4-4"/></svg>
      <span class="label">Enrollments</span>
    </a>
    <a href="/admin/sessions" class="side-link<%= isActive('sessions') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M3 10h18"/><path d="M8 2v4M16 2v4"/><path d="M9 15l2 2 4-4"/></svg>
      <span class="label">Class Sessions</span>
    </a>
    <a href="/admin/blog" class="side-link<%= isActive('blog') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      <span class="label">Blog</span>
    </a>
    <a href="/admin/programs" class="side-link<%= isActive('programs') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      <span class="label">Programs</span>
    </a>
    <a href="/admin/leads" class="side-link<%= isActive('leads') %>">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      <span class="label">Leads</span>
    </a>
    <% if (typeof user !== 'undefined' && user && user.is_super_admin) { %>
      <a href="/admin/admins" class="side-link<%= isActive('admins') %>">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/></svg>
        <span class="label">Manage Admins</span>
      </a>
    <% } %>
  </nav>

  <div class="side-bottom">
    <div class="side-link logout-link">
      <form method="POST" action="/admin/logout" style="width:100%">
        <button type="submit">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
          <span class="label">Log Out</span>
        </button>
      </form>
    </div>
  </div>
</aside>

<script>
(function(){
  var shell = document.getElementById('adminShell');
  var btn = document.getElementById('sidebarToggle');
  if (!shell || !btn) return;
  var KEY = 'sm_admin_sidebar_expanded';
  var saved = localStorage.getItem(KEY);
  if (saved === null || saved === 'true') shell.classList.add('expanded');
  btn.addEventListener('click', function(){
    var expanded = shell.classList.toggle('expanded');
    localStorage.setItem(KEY, expanded);
  });
})();
</script>
