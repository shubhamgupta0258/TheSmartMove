<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Admin Login — The Smart Move</title>
<meta name="robots" content="noindex, nofollow" />
<link rel="stylesheet" href="/css/style.css" />
<style>
  .auth-shell{ min-height:100vh; display:grid; place-items:center; padding:2rem 1.2rem; }
  .auth-box{ width:100%; max-width:420px; }
  .auth-box .form{ padding:2.2rem; }
  .auth-error{ padding:.85rem 1rem; border-radius:12px; background:rgba(255,80,80,.1); border:1px solid rgba(255,80,80,.3); color:#ff9d9d; font-size:.88rem; margin-bottom:1.2rem; }
</style>
</head>
<body style="background:var(--bg)">

<div class="auth-shell">
  <div class="auth-box">
    <div style="text-align:center; margin-bottom:1.6rem">
      <span class="word" style="font-family:var(--font-data); font-weight:700; font-size:1.3rem; color:var(--ink)">SMART <span class="m" style="color:var(--gold)">MOVE</span></span>
      <p style="color:var(--ink-faint); font-size:.82rem; letter-spacing:.1em; text-transform:uppercase; margin-top:.4rem">Admin Panel</p>
    </div>

    <div class="form" style="text-align:center">
      <h3>Admin Login</h3>
      <p class="lead">Sign in with the Google account registered as an admin.</p>

      <% if (error) { %>
        <div class="auth-error" style="text-align:left"><%= error %></div>
      <% } %>

      <a href="/admin/auth/google" class="btn btn-gold btn-block" style="display:flex; align-items:center; justify-content:center; gap:.6rem">
        <svg width="18" height="18" viewBox="0 0 48 48">
          <path fill="#EA4335" d="M24 9.5c3.5 0 6.6 1.2 9.1 3.6l6.8-6.8C35.9 2.4 30.3 0 24 0 14.6 0 6.5 5.4 2.5 13.2l7.9 6.1C12.3 13.1 17.7 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.5 24.5c0-1.6-.1-3.1-.4-4.5H24v9h12.7c-.5 3-2.2 5.5-4.7 7.2l7.4 5.7C43.9 37.5 46.5 31.5 46.5 24.5z"/>
          <path fill="#FBBC05" d="M10.4 28.4c-.5-1.4-.8-3-.8-4.4s.3-3 .8-4.4l-7.9-6.1C.9 16.5 0 20.1 0 24s.9 7.5 2.5 10.5l7.9-6.1z"/>
          <path fill="#34A853" d="M24 48c6.3 0 11.6-2.1 15.5-5.6l-7.4-5.7c-2.1 1.4-4.8 2.3-8.1 2.3-6.3 0-11.7-3.6-13.6-8.9l-7.9 6.1C6.5 42.6 14.6 48 24 48z"/>
        </svg>
        Continue with Google
      </a>
    </div>
  </div>
</div>

</body>
</html>
