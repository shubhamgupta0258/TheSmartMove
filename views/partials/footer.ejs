<!-- ====================== EXIT INTENT MODAL ====================== -->
<div class="modal-veil" id="exitModal">
  <div class="modal">
    <button class="close" id="modalClose" aria-label="Close">✕</button>
    <span class="mmark">
      <svg viewBox="0 0 100 100" width="56" height="56" fill="none">
        <circle cx="50" cy="52" r="33" stroke="#D4AF37" stroke-width="4"/>
        <path d="M50 5 L57 26 L50 21 L43 26 Z" fill="#00C853"/>
        <rect x="47.2" y="21" width="5.6" height="46" rx="2" fill="#00C853"/>
      </svg>
    </span>
    <h3>Before You Go…</h3>
    <p>Book a <b style="color:var(--gold)">free consultation</b> with our team and get a clear direction for your trading journey — no cost, no pressure.</p>
    <a href="<%= link('#book') %>" class="btn btn-gold" id="modalCta">Book My Free Session</a>
    <small>Every successful trader starts with the right direction.</small>
  </div>
</div>

<!-- ====================== MARKET INFO MODAL ======================= -->
<div class="modal-veil" id="marketModal">
