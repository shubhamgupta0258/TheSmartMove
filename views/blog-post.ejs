<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= post.title %> — The Smart Move</title>
<meta name="description" content="<%= post.body.slice(0, 155).replace(/\s+\S*$/, '') %>…" />
<meta name="theme-color" content="#0B0B0B" />
<link rel="preconnect" href="https://api.fontshare.com" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@700,900,500&f[]=general-sans@600,700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='34' fill='none' stroke='%23D4AF37' stroke-width='5'/%3E%3Cpath d='M50 8 L58 30 L50 24 L42 30 Z' fill='%2300C853'/%3E%3Crect x='47' y='24' width='6' height='40' fill='%2300C853'/%3E%3Ctext x='50' y='68' font-family='Arial' font-size='30' font-weight='900' fill='%23D4AF37' text-anchor='middle'%3ESM%3C/text%3E%3C/svg%3E" />
<link rel="stylesheet" href="/css/style.css" />
<style>
  .article-wrap{ max-width:720px; margin-inline:auto; padding-top:clamp(120px,15vw,180px); padding-bottom:5rem; }
  .article-wrap .back{ display:inline-flex; align-items:center; gap:.4rem; color:var(--gold); font-size:.85rem; font-weight:600; margin-bottom:2rem; }
  .article-wrap .meta{ display:flex; gap:.8rem; font-size:.8rem; color:var(--ink-faint); margin:1rem 0 2rem; }
  .article-wrap h1{ font-size:clamp(1.8rem,4vw,2.6rem); line-height:1.2; }
  .article-body p{ color:var(--ink-soft); font-size:1.05rem; line-height:1.8; margin-bottom:1.4rem; }
  .article-wrap .cat-badge{ font-size:.72rem; letter-spacing:.08em; text-transform:uppercase; color:var(--gold); border:1px solid rgba(212,175,55,.4); border-radius:20px; padding:.25rem .8rem; }
</style>
</head>
<body>
<%- include('partials/nav', { home: false }) %>

<main>
<article class="wrap article-wrap reveal in">
  <a href="/blog" class="back"><svg viewBox="0 0 24 24" width="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M11 18l-6-6 6-6"/></svg> Back to Insights</a>

  <span class="cat-badge"><%= post.category %></span>
  <h1 style="margin-top:1rem"><%= post.title %></h1>
  <div class="meta">
    <span><%= post.author || 'The Smart Move Team' %></span>
    <span>·</span>
    <span><%= post.read_time_minutes %> min read</span>
  </div>

  <div class="article-body">
    <% post.body.split(/\n\s*\n/).forEach(function(para) { %>
      <p><%= para.trim() %></p>
    <% }); %>
  </div>

  <div style="margin-top:3rem; padding-top:2rem; border-top:1px solid var(--stroke-soft)">
    <a href="/#book" class="btn btn-gold">Book a Free Consultation</a>
  </div>
</article>
</main>

<%- include('partials/footer', { home: false }) %>
</body>
</html>
