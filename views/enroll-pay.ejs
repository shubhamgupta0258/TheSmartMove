<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Complete Enrollment — The Smart Move</title>
<meta name="robots" content="noindex, nofollow" />
<link rel="preconnect" href="https://api.fontshare.com" crossorigin />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://api.fontshare.com/v2/css?f[]=satoshi@700,900,500&f[]=general-sans@600,700&display=swap" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='34' fill='none' stroke='%23D4AF37' stroke-width='5'/%3E%3Cpath d='M50 8 L58 30 L50 24 L42 30 Z' fill='%2300C853'/%3E%3Crect x='47' y='24' width='6' height='40' fill='%2300C853'/%3E%3Ctext x='50' y='68' font-family='Arial' font-size='30' font-weight='900' fill='%23D4AF37' text-anchor='middle'%3ESM%3C/text%3E%3C/svg%3E" />
<link rel="stylesheet" href="/css/style.css" />
<style>
  .pay-wrap{ max-width:480px; margin-inline:auto; padding-top:clamp(120px,15vw,180px); padding-bottom:5rem; }
  .pay-qr{ display:flex; justify-content:center; margin:1.6rem 0; }
  .pay-qr img{ width:220px; height:220px; border-radius:16px; background:#fff; padding:12px; }
  .pay-amount{ text-align:center; font-family:var(--font-data); font-weight:700; font-size:2rem; color:var(--gold); margin-bottom:.2rem; }
  .pay-upi{ text-align:center; color:var(--ink-soft); font-size:.9rem; margin-bottom:1.6rem; }
  .pay-upi b{ color:var(--ink); font-family:var(--font-data); }
  .status-note{ padding:1rem 1.1rem; border-radius:12px; font-size:.88rem; margin-top:1.4rem; text-align:center; }
  .status-note.pending{ background:rgba(212,175,55,.1); border:1px solid rgba(212,175,55,.3); color:var(--gold-bright); }
  .status-note.confirmed{ background:rgba(0,200,83,.1); border:1px solid rgba(0,200,83,.3); color:#8ff0b6; }
</style>
</head>
<body>
<%- include('partials/nav', { home: false }) %>

<main>
<div class="wrap pay-wrap reveal in">
  <div class="section-head reveal in" style="margin-inline:auto; text-align:center">
    <span class="eyebrow">Complete Enrollment</span>
    <h2 style="margin-top:1.1rem"><%= program.name %></h2>
  </div>

  <div class="form" style="margin-top:1.6rem">
    <div class="pay-amount">₹<%= enrollment.amount.toLocaleString('en-IN') %></div>

    <div class="pay-qr">
      <img src="<%= qrDataUrl %>" alt="UPI QR code" />
    </div>

    <div class="pay-upi">Pay via UPI ID: <b><%= upiId %></b></div>

    <a href="<%= waLink %>" class="btn btn-green btn-block" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm4.4 12c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8 1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 0 0-.7.3 2.8 2.8 0 0 0-.9 2.1 4.9 4.9 0 0 0 1 2.5 11 11 0 0 0 4.3 3.8c1.6.6 1.8.5 2.1.5a2.5 2.5 0 0 0 1.6-1.1 2 2 0 0 0 .1-1.1c0-.1-.2-.2-.4-.3z"/></svg>
      Send Payment Confirmation on WhatsApp
    </a>

    <% if (enrollment.status === 'pending') { %>
      <div class="status-note pending">Your enrollment is pending confirmation. We'll unlock this program in your account once we verify your payment.</div>
    <% } %>

    <p style="text-align:center; margin-top:1.4rem">
      <a href="/student/dashboard" style="color:var(--ink-faint); font-size:.85rem">Back to My Account</a>
    </p>
  </div>
</div>
</main>

<%- include('partials/footer', { home: false }) %>
</body>
</html>
